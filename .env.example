# Copy this file to `.env` and fill in your Azure OpenAI values.
# The .env file is git-ignored and stays on your machine only.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<paste-your-azure-openai-key-here>"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4.1"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"

# --- Local ports (used by start.ps1 when running two processes locally) ---
MOCK_SOURCE_PORT=8001
BACKEND_PORT=8000

# --- Set to 1 to skip LLM calls entirely and use deterministic fallbacks ---
OFFLINE_MODE=0

# --- Password gate (leave blank to disable). Also required in production. ---
APP_PASSWORD=

# --- Bearer token for the mock Oracle CC&B endpoints ---
MOCK_SOURCE_TOKEN=demo-token
